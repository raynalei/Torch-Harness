{
  "plugins": {
    "config": {
      "protein-design": {
        "model_services": {
          "ppiflow": {
            "kind": "ppiflow",
            "service": {
              "url": "http://slurm-api.invalid:8010",
              "health_path": "/openapi.json",
              "sbatch_script": "/lustre/project/apis/ppiflow/ppiflow-api.sbatch",
              "sbatch_resolve_host": true
            },
            "max_samples": 10,
            "allowed_input_roots": [
              "/lustre/project"
            ]
          },
          "torchcraft": {
            "kind": "torchcraft",
            "service": {
              "url": "http://slurm-api.invalid:8020",
              "health_path": "/openapi.json",
              "sbatch_script": "/lustre/project/apis/torchcraft/torchcraft-api.sbatch",
              "sbatch_resolve_host": true
            },
            "max_samples": 10,
            "allowed_input_roots": [
              "/lustre/project"
            ]
          },
          "rosetta": {
            "kind": "rosetta",
            "service": {
              "backend": "slurm",
              "python": "/lustre/grp/cmclab/leiy/conda_envs/ppi_env/bin/python",
              "partition": "sugon",
              "cpus": 4,
              "memory": "16G",
              "walltime": "04:00:00",
              "metric_fields": {
                "interface_dg": "dG_separated"
              },
              "environment": {
                "OMP_NUM_THREADS": "4"
              }
            },
            "max_samples": 5,
            "allowed_input_roots": [
              "/lustre/project"
            ]
          },
          "af3score": {
            "kind": "af3score",
            "service": {
              "url": "http://slurm-api.invalid:8040",
              "sbatch_script": "/lustre/project/apis/af3score/af3score-api.sbatch",
              "sbatch_resolve_host": true
            },
            "max_samples": 5,
            "allowed_input_roots": [
              "/lustre/project"
            ]
          },
          "torchfold": {
            "kind": "torchfold",
            "service": {
              "url": "http://slurm-api.invalid:8050",
              "sbatch_script": "/lustre/project/apis/torchfold/torchfold-api.sbatch",
              "sbatch_resolve_host": true
            },
            "max_samples": 5,
            "allowed_input_roots": [
              "/lustre/project"
            ]
          },
          "torchscore": {
            "kind": "torchscore",
            "service": {
              "url": "http://slurm-api.invalid:8070",
              "sbatch_script": "/lustre/project/apis/torchscore/torchscore-api.sbatch",
              "sbatch_resolve_host": true
            },
            "max_samples": 1,
            "allowed_input_roots": [
              "/lustre/project"
            ]
          },
          "torchopt": {
            "kind": "torchopt",
            "service": {
              "url": "http://slurm-api.invalid:8060",
              "status_field": "state",
              "sbatch_script": "/lustre/project/apis/torchopt/torchopt-api.sbatch",
              "sbatch_resolve_host": true
            },
            "allowed_input_roots": [
              "/lustre/project"
            ]
          },
          "rfd4": {
            "kind": "rfd4",
            "max_samples": 512,
            "allowed_input_roots": [
              "/lustre/grp/cmclab"
            ],
            "request_defaults": {},
            "service": {
              "url": "http://slurm-api.invalid:8080",
              "health_service": "rfd4",
              "health_job_id": true,
              "sbatch_script": "/lustre/grp/cmclab/leiy/rfd4_api/rfd4_api.sbatch",
              "sbatch_chdir": "/lustre/grp/cmclab/leiy/rfd4_api",
              "environment": {
                "RFD4_API_DIR": "/lustre/grp/cmclab/leiy/rfd4_api",
                "RFD4_PORT": "8080",
                "RFD4_SIF": "/lustre/grp/cmclab/leiy/containers/rfd4-proteina-cu12-amd64.sif",
                "RFD4_WEIGHTS": "/lustre/grp/cmclab/leiy/models/rfd4-proteina",
                "RFD4_INPUTS": "/lustre/grp/cmclab/leiy/rfd4_api_inputs",
                "RFD4_JOBS": "/lustre/grp/cmclab/leiy/rfd4_api_jobs"
              }
            }
          },
          "proteinmpnn": {
            "kind": "proteinmpnn",
            "max_samples": 512,
            "allowed_input_roots": [
              "/lustre/grp/cmclab/leiy",
              "/lustre/grp/cmclab/share"
            ],
            "request_defaults": {},
            "service": {
              "url": "http://slurm-api.invalid:8090",
              "health_service": "proteinmpnn",
              "health_job_id": true,
              "sbatch_script": "/lustre/grp/cmclab/leiy/proteinmpnn_api/proteinmpnn_api.sbatch",
              "sbatch_chdir": "/lustre/grp/cmclab/leiy/proteinmpnn_api",
              "environment": {
                "PROTEINMPNN_API_PYTHON": "/lustre/grp/cmclab/leiy/conda_envs/proteinmpnn_api/bin/python",
                "PROTEINMPNN_SIF": "/lustre/grp/cmclab/leiy/containers/proteinmpnn.sif",
                "PROTEINMPNN_WEIGHTS": "/lustre/grp/cmclab/leiy/models/proteinMPNN/v_48_020.pt",
                "PROTEINMPNN_WORK": "/lustre/grp/cmclab/leiy/proteinmpnn_api_jobs",
                "PROTEINMPNN_INPUT_ROOTS": "/lustre/grp/cmclab/leiy:/lustre/grp/cmclab/share"
              }
            }
          }
        }
      }
    }
  }
}
